# Copy this file to .env and fill in the values. .env is gitignored: never commit it.

# Claude API key, from the Anthropic Console (API keys).
ANTHROPIC_API_KEY=

# MongoDB Atlas connection string for the question log, from Connect > Drivers > Python,
# with the database user's password in place of <db_password>. Leave it empty to log
# questions to data/logs/questions.jsonl instead.
QUERY_CF_MONGODB_URI=
